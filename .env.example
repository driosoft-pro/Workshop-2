# ============================================================================
# Workshop-2 - Reliable Batch Data Pipeline (Spotify + Grammy Awards)
# Template of required environment variables. Copy to .env and adjust.
# NEVER commit real credentials.
# ============================================================================

# --- Airflow ---
# Container uid for every Airflow service (compose sets HOME=/home/airflow so
# the Airflow CLI still resolves its user site-packages).
#   rootless Podman: 0  (container root maps to the invoking host user, so
#                       bind-mounted logs/evidence stay owned by you)
#   Docker Desktop  : AIRFLOW_UID=$(id -u)   e.g. 1000
AIRFLOW_UID=0
AIRFLOW_IMAGE_NAME=workshop2-airflow:3.1.8
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Local development JWT secret (replace in any shared environment).
AIRFLOW__API_AUTH__JWT_SECRET=change-me-local-dev-only

# --- Grammy SOURCE database (source preparation - NOT the Data Warehouse) ---
POSTGRES_USER=music
POSTGRES_PASSWORD=music
POSTGRES_DB=music_source
# Host-side port for the source/DW PostgreSQL server.
# Exposed on 0.0.0.0 so Power BI (Windows 11 VM) can reach music_dw.
MUSIC_POSTGRES_PORT=5432
MUSIC_SOURCE_DB_URL=postgresql+psycopg2://music:music@music-postgres:5432/music_source

# --- Data Warehouse database (analytical target) ---
MUSIC_DW_DB_URL=postgresql+psycopg2://music:music@music-postgres:5432/music_dw

# --- Pipeline file layout (inside the containers) ---
MUSIC_DATA_DIR=/opt/airflow/data
MUSIC_GX_DIR=/opt/airflow/gx
MUSIC_EVIDENCE_DIR=/opt/airflow/docs/evidence

# --- Source selection ---
# Filename (inside MUSIC_DATA_DIR/raw) used by the Spotify branch.
# Controlled-failure test: switch to spotify_bad.csv (created by scripts/make_bad_data.py).
SPOTIFY_SOURCE_FILENAME=spotify_dataset.csv
GRAMMY_SOURCE_FILENAME=the_grammy_awards.csv

# --- Load strategy for the DW (replace = transactional delete+insert per batch) ---
DW_LOAD_STRATEGY=replace

# --- Apache Superset (primary BI layer over music_dw) ---
SUPERSET_SECRET_KEY=workshop2-dev-secret-change-me
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_IMAGE_NAME=workshop2-superset:4.1.4
